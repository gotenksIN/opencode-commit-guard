{
  "name": "opencode-commit-guard",
  "version": "1.1.0",
  "description": "OpenCode V2 plugin enforcing git commit format rules",
  "homepage": "https://github.com/gotenksIN/opencode-commit-guard",
  "license": "MIT",
  "author": {
    "name": "Omkar Chandorkar",
    "email": "gotenksIN@aospa.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotenksIN/opencode-commit-guard.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "check": "oxlint --type-aware . && oxfmt --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build index.ts --outdir dist --target bun --format esm --external @opencode/plugin --external effect",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@opencode/plugin": "latest",
    "@types/bun": "1.4.4",
    "effect": "4.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "7.0.2",
    "ultracite": "^8.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0",
    "effect": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
